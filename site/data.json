{"people":[{"id":"lin","name":"لين","role":"المهندس","desc":"مهندس انتقل مع زوجته إلى قرية في عالم مجهول، ومعه نظام لا يعرف أكثر مما تسمح به بياناته. مباشر، ويفكر بصوت مسموع بالأرقام والأسباب، وساخر في سره أحياناً.","color":"#2f6db3"},{"id":"shen","name":"شين يان","role":"زوجة لين","desc":"حامل، قصيرة الجمل وحادة، تسأل أكثر مما تجيب. تقول «أثبت» ولا تقول «أصدقك». الدفاتر والبنود سلاحها.","color":"#b0461f"},{"id":"hu","name":"هو سانيانغ","role":"صاحبة نزل الصفصافة","desc":"عملية، تتكلم بالأثمان والديون. لا تشكر، بل تضع طعاماً أمامك. النزل هو كل ما تملك.","color":"#7a5a12"},{"id":"xiaodu","name":"شياو دو","role":"صبي النزل","desc":"فضولي وثرثار، يقلد الناس ويضحك ثم يعتذر.","color":"#2e8a5b"},{"id":"zhang","name":"تشانغ","role":"الحداد","desc":"قليل الكلام، ومتكبر في صنعته. يقول «جرّب» بدل «لا». ورشته عند الطرف الجنوبي للقرية.","color":"#5b5b5b"},{"id":"wu","name":"الكاتب وو","role":"كاتب السجلات","desc":"مهذب أكثر من اللازم، ويسأل الأسئلة الصحيحة بنبرة عابرة.","color":"#6a3fa0"},{"id":"qian","name":"التاجر تشيان","role":"تاجر الحديد والملح","desc":"لطيف ومبتسم، وكل جملة عنده فيها رقم. يجلب الحديد والملح من البلدة.","color":"#a8326e"},{"id":"agent","name":"وكيل ليو","role":"وكيل عائلة ليو","desc":"يدير أملاك عائلة ليو، أكبر ملاك الأرض في المنطقة. يُرى غالباً فوق حصانه.","color":"#8c1c1c"},{"id":"yang","name":"العجوز يانغ","role":"نجار عجوز","desc":"عجوز يعرف الخشب والدواليب، يقول «لا» من مكانه قبل أن يقوم.","color":"#4f6b2a"},{"id":"laoma","name":"لاو ما","role":"رئيس قافلة","desc":"رجل قافلة يضحك كثيراً وينظر طويلاً قبل أن يتحرك.","color":"#9a6b2f"},{"id":"laodong","name":"لاو دونغ","role":"عامل","desc":"رجل قصير عريض يشبه برميلاً.","color":"#6b4a2e"},{"id":"qiu","name":"تشيو","role":"عامل شاب","desc":"شاب نحيف سريع الغضب.","color":"#2a7b8c"},{"id":"tian","name":"العم تيان","role":"صاحب الحمار","desc":"رجل هادئ يعرف الدواب، يهمس في أذن الحمار فيهدأ.","color":"#7b6f61"}],"places":[{"id":"inn","name":"نزل الصفصافة","desc":"نزل هو سانيانغ على طريق القوافل. هنا الموقد الأ